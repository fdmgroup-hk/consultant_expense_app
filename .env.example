# ============================================================
#  Consultant Experience App - configuration
#  Copy to `.env` and fill in. `.env` is git-ignored.
# ============================================================

# --- LLM provider ------------------------------------------
# cloudflare -> Cloudflare Workers AI serving @cf/openai/gpt-oss-120b. Free
#              allowance of 10,000 Neurons/day (~75 grounded answers). The default.
# groq      -> Groq serving openai/gpt-oss-120b. Free, very fast.
# gemini    -> Google Gemini. Free but tightly rate limited per day.
# anthropic -> Claude. Paid, no free tier, strongest at nuanced feedback.
LLM_PROVIDER=cloudflare

# --- Cloudflare Workers AI (required when LLM_PROVIDER=cloudflare) ---
# Token: Cloudflare > My Profile > API Tokens (Workers AI permission)
# Account id: it is the hex string in your dashboard URL
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/openai/gpt-oss-120b
CF_SHOW_THINKING=true

# --- Groq (required when LLM_PROVIDER=groq) -----------------
# Free key, no card needed: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# none | default | low | medium | high  (higher = better answers, slower)
GROQ_REASONING_EFFORT=medium
GROQ_SHOW_THINKING=true

# --- Google Gemini (required when LLM_PROVIDER=gemini) ------
# Free key, no card needed: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Stream Gemini's reasoning summary into the UI's collapsible panel
GEMINI_SHOW_THINKING=true

# --- Claude (only when LLM_PROVIDER=anthropic) --------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
# Show Claude's reasoning summary in the UI (summarized | omitted)
ANTHROPIC_THINKING_DISPLAY=summarized
# Server-side refusal fallback (Claude API only; disable on Bedrock/Vertex/Foundry)
ANTHROPIC_SERVER_FALLBACKS=true

# --- Embeddings --------------------------------------------
# auto | voyage | fastembed | hashing
#   voyage    -> hosted, free tier, best retrieval quality (needs VOYAGE_API_KEY)
#   fastembed -> runs locally, no API key, no data leaves the machine
#   hashing   -> zero-dependency fallback, works out of the box
EMBEDDING_PROVIDER=auto
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Database ----------------------------------------------
# Empty  -> SQLite at data/consultant_experience.db. Correct for local work.
# Hosted -> the Supabase TRANSACTION POOLER string (port 6543, not 5432).
#           Project Settings > Database > Connection string > Transaction pooler
# DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_POOL_SIZE=5

# --- Storage for the original decks -------------------------
DATA_DIR=./data

# local    -> a folder on disk. Correct locally; WRONG on Render/Fly, whose
#             filesystems are wiped on every deploy, taking the uploads with them.
# supabase -> Supabase Storage via its REST API. Best when hosting on Supabase:
#             authenticates with the service-role key, so there are no separate
#             S3 access keys to create by hand.
# s3       -> any other S3-compatible store: Cloudflare R2, MinIO, AWS.
# none     -> keep no originals. Search still works; no re-extracting later.
STORAGE_BACKEND=local

# For STORAGE_BACKEND=supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=consultant-originals

# Supabase: Project Settings > Storage > S3 Connection (bucket must be PRIVATE)
S3_ENDPOINT_URL=
S3_BUCKET=consultant-originals
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-1

# --- Access control ----------------------------------------
# Token required to upload/delete knowledge-base documents.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-before-deploying

# Optional whole-site password (HTTP Basic). Empty = anyone with the URL can
# read and search; uploads still need ADMIN_TOKEN either way. Set this before
# real client material goes onto a public URL.
APP_PASSWORD=

# Extra origins allowed to call the API cross-origin. Not needed when the UI is
# served by this same app, which it is by default.
ALLOWED_ORIGINS=

# --- Retrieval tuning --------------------------------------
RETRIEVAL_TOP_K=8
CHUNK_TARGET_CHARS=1100
CHUNK_OVERLAP_CHARS=180
